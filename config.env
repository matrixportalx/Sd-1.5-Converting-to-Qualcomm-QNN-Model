# config.env — SDK indirmesinin tek ayar yeri.
#
# scripts/setup_qnn_sdk.py bu dosyadan YALNIZCA su uc anahtari okur; baska
# hicbir sey buradan okunmaz. Hattin kendi ayarlari (RESOLUTIONS, CLIP_SKIP,
# CALIB_LIMIT, REALISTIC, CACHE_REPO ...) ortam degiskenidir; bkz.
# docs/03-donusum-adimlari.md.
#
# SURUM SART: hat QNN 2.28 ile calisir. 2.39 ile kosmak saatleri bosa harcar,
# cikan paket cihazda yuklenmez. Burayi yalnizca indirme linki bozulursa
# (Qualcomm URL'yi degistirirse) elleyin.

# Dogrudan indirme linki (varsa tag/repo yok sayilir)
OVERRIDE_QAIRT_ASSET_URL=https://apigwx-aws.qualcomm.com/qsc/public/v1/api/download/software/qualcomm_neural_processing_sdk/v2.28.0.241029.zip

# Alternatif kaynak: bir GitHub release'inden indir
#OVERRIDE_QAIRT_REPO=matrixportalx/qairt-sdk
#OVERRIDE_QAIRT_TAG=v2.28.0.241029
