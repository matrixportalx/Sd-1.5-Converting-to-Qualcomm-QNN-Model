# =============================================================================
# config.env — NOT DEFTERINE DOKUNMADAN ayar degistirmek icin.
#
# Bu dosya notebook'un 2. adiminda `git reset --hard` ile guncellenir. Yani:
#   * Not defterini YENIDEN ACMAYA gerek yok (yeni calisma zamani = sifirdan
#     derleme demek).
#   * Ayni oturumda 2. adimi calistirip 6. adima gecmek yeterli.
#
# OVERRIDE_<AD>=<deger> satirlari notebook'taki secimleri EZER.
# Bos birakilan ya da yorumlanan satirlar notebook'un secimini birakir.
# =============================================================================

# --- UNet kuantizasyon modu --------------------------------------------------
# a8w8_io16      : ic hesap 8-bit + graf sinirlari (sample/text_embedding/
#                  output) 16-bit. Referans binary'nin yaptigi. AKTIF SECIM.
# a16w8_restrict : tam 16-bit aktivasyon. 2.39'da LayerNorm dogrulamasi
#                  dusuyordu; 2.40 bunu "LayerNorm Op failed validation due to
#                  an unsupported data type" olarak DUZELTMIS -> tekrar AKTIF.
# a8w8           : tam 8-bit. Derlenir ama motor uint16 yazdigi icin cihazda
#                  YUKLENMEZ. Sadece boru hattini sinamak icin.
OVERRIDE_UNET_MODE=a16w8_restrict

# --- Hizli deneme ------------------------------------------------------------
# 1 = kalibrasyon asgariye iner -> kuantizasyon ~8 dk yerine ~1 dk.
#     Model calisir ama KALITESI DUSUKTUR; derleme dogrulaninca 0 yapin.
OVERRIDE_FAST_TRIAL=1

# --- SDK surum yoklamasi -----------------------------------------------------
# 1 = kosunun basinda Qualcomm Software Center'in DOGRUDAN API yolundan hangi
#     QAIRT surumlerinin hala indirilebildigini yoklar (~30 sn, donusumu
#     engellemez). Arayuz eski surumleri listelemiyor ama API genelde sunuyor.
#     Referans modeller QNN 2.28 ile uretilmis; 2.28 inebiliyorsa asil cozum o.
OVERRIDE_PROBE_SDK=1

# Yoklama bir surum bulursa buraya yazilir; setup_qnn_sdk.py (4. adim)
# config.env'i kendisi okudugu icin NOT DEFTERINE DOKUNMAYA GEREK YOK.
# QAIRT 2.40.0 (Ekim 2025) surum notlari — bizim IKI hatamiz da burada duzeltilmis:
#   "Tool:Converter: Resolved an issue where models with Conv2d ops failed on the
#    HTP backend due to unsupported input or output data types. {153277}"
#   "Tool:Converter: Resolved an issue where the LayerNorm Op failed validation
#    due to an unsupported data type. {153276}"
# Yani cozum ESKI degil YENI surum. 2.47.0'ta ayrica
#   "Tool:Converter: Fixed a Convert Op issue in the mixed-precision stage."
OVERRIDE_QAIRT_ASSET_URL=https://softwarecenter.qualcomm.com/api/download/software/sdks/Qualcomm_AI_Runtime_Community/All/2.40.0.251030/v2.40.0.251030.zip
OVERRIDE_QNN_VERSION=2.40
# Inmezse yoklama ciktisindan calisan bir surumu buraya yazin, or.:
#OVERRIDE_QAIRT_ASSET_URL=https://softwarecenter.qualcomm.com/api/download/software/sdks/Qualcomm_AI_Runtime_Community/All/2.47.0.260601/v2.47.0.260601.zip

# --- Digerleri (gerekirse acilir) --------------------------------------------
#OVERRIDE_DSP_ARCH=v68
#OVERRIDE_TARGET_SOC=
#OVERRIDE_PER_CHANNEL=0
#OVERRIDE_QUANT_EXTRA=
#OVERRIDE_REBUILD_BIN=0
#OVERRIDE_UNET_WEIGHT_BW=8
