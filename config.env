# =============================================================================
# config.env — NOT DEFTERINE DOKUNMADAN ayar degistirmek icin.
#
# Bu dosya notebook'un 2. adiminda `git reset --hard` ile guncellenir. Yani:
#   * Not defterini YENIDEN ACMAYA gerek yok (yeni calisma zamani = sifirdan
#     derleme demek).
#   * Ayni oturumda 2. adimi calistirip 6. adima gecmek yeterli.
#
# OVERRIDE_<AD>=<deger> satirlari notebook'taki secimleri EZER.
# Bos birakilan ya da yorumlanan satirlar notebook'un secimini birakir.
# =============================================================================

# --- UNet kuantizasyon modu --------------------------------------------------
# a8w8_io16cfg   : ic hesap 8-bit + graf sinirlari uint16/int32, SDK'nin RESMI
#                  --config YAML yoluyla (sema: --dump_config_template).
#                  Sinirda kalir, ic grafa sizmaz. AKTIF SECIM.
# a8w8_io16      : ayni fikir ama --quantization_overrides ile. ELENDI —
#                  16-bit etiketi to_k/to_v uzerinden ic grafa siziyor
#                  ("8 bit activations with 16 bit weights").
# a16w8_restrict : tam 16-bit aktivasyon. ELENDI — LayerNorm 16-bit'i
#                  v68/v69'da yok; 2.39 ve 2.40'ta ayni hata.
# a8w8           : tam 8-bit. Derlenir ama motor uint16 yazdigi icin cihazda
#                  YUKLENMEZ. Sadece boru hattini sinamak icin.
OVERRIDE_UNET_MODE=a8w8_io16cfg

# --- Hizli deneme ------------------------------------------------------------
# 1 = kalibrasyon asgariye iner -> kuantizasyon ~8 dk yerine ~1 dk.
#     Model calisir ama KALITESI DUSUKTUR; derleme dogrulaninca 0 yapin.
OVERRIDE_FAST_TRIAL=1

# --- SDK surum yoklamasi -----------------------------------------------------
# 1 = kosunun basinda Qualcomm Software Center'in DOGRUDAN API yolundan hangi
#     QAIRT surumlerinin hala indirilebildigini yoklar (~30 sn, donusumu
#     engellemez). Arayuz eski surumleri listelemiyor ama API genelde sunuyor.
#     Referans modeller QNN 2.28 ile uretilmis; 2.28 inebiliyorsa asil cozum o.
# 2.39 baska bir yerde takilirsa hangi surumlerin hala inebildigini bilmemiz
# lazim (or. referansin uretildigi 2.28). ~30 sn, donusumu engellemez.
OVERRIDE_PROBE_SDK=0   # tamamlandi: 2.28 YOK (404), en eski 2.32

# Yoklama bir surum bulursa buraya yazilir; setup_qnn_sdk.py (4. adim)
# config.env'i kendisi okudugu icin NOT DEFTERINE DOKUNMAYA GEREK YOK.
# QAIRT 2.40.0 (Ekim 2025) surum notlari — bizim IKI hatamiz da burada duzeltilmis:
#   "Tool:Converter: Resolved an issue where models with Conv2d ops failed on the
#    HTP backend due to unsupported input or output data types. {153277}"
#   "Tool:Converter: Resolved an issue where the LayerNorm Op failed validation
#    due to an unsupported data type. {153276}"
# Yani cozum ESKI degil YENI surum. 2.47.0'ta ayrica
#   "Tool:Converter: Fixed a Convert Op issue in the mixed-precision stage."
# !!! SURUM UYGULAMAYA GORE SECILIR — KEYFI DEGIL !!!
# Context binary'ler GERIYE uyumludur, ILERIYE DEGILDIR. local-dream'in
# app/src/main/cpp/CMakeLists.txt dosyasi sunu diyor:
#     set(QNN_SDK_ROOT /data/qairt/2.39.0.250926)
# Yani uygulamanin icindeki libQnnHtp.so 2.39. 2.40 ile urettigimiz unet.bin
# cihazda "Motor sureci beklenmedik sekilde kapandi (kod 1) / Could not free
# context" ile reddedildi. Referans paketin 2.28 olup CALISMASI da bunu
# dogruluyor (eski binary + yeni runtime = sorun yok).
# ---> Uygulamanizi hangi QAIRT ile derlediyseniz O surumu kullanin. <---
# AKTIF: 2.28 — rehberin sart kostugu surum ("please use v2.28 to avoid
# potential issues") ve referans paketlerin uretildigi surum. Farkli urun
# yolunda durdugu icin eski yoklamalarimiz 404 vermisti.
OVERRIDE_QAIRT_ASSET_URL=https://apigwx-aws.qualcomm.com/qsc/public/v1/api/download/software/qualcomm_neural_processing_sdk/v2.28.0.241029.zip
OVERRIDE_QNN_VERSION=2.28
# 2.39 (uygulamanin derlendigi surum; bizim onceki denemelerimiz):
#OVERRIDE_QAIRT_ASSET_URL=https://softwarecenter.qualcomm.com/api/download/software/sdks/Qualcomm_AI_Runtime_Community/All/2.39.0.250926/v2.39.0.250926.zip
#OVERRIDE_QNN_VERSION=2.39
# 2.40 (uygulama 2.40 ile yeniden derlenirse):
#OVERRIDE_QAIRT_ASSET_URL=https://softwarecenter.qualcomm.com/api/download/software/sdks/Qualcomm_AI_Runtime_Community/All/2.40.0.251030/v2.40.0.251030.zip
#
# NOT: 2.28'de qairt-converter ve qnn-context-binary-generator --dlc_path
# olmayabilir; o durumda bizim adim 4 hattimiz calismaz ve resmi akisa
# (qnn-onnx-converter -> qnn-model-lib-generator -> --model <.so>) geceriz.
# Bu kosuda FETCH_ONLY=1 oldugu icin donusum zaten calismiyor.

# --- Disk (Colab'da dar) -----------------------------------------------------
# Adim 4'te "No space left on device" aldik: qairt-converter ONNX'in harici
# agirliklarini gecici dizine kopyaliyor (~3.4 GB) ve ustune fp32 DLC uretiyor
# (~3.4 GB). Alinan onlemler:
#   * pipeline/ hazir olunca input.safetensors siliniyor (KEEP_CKPT=1 ile kalir)
#   * clip.onnx / clip.mnn artik uretilmiyor (referans pakette yok)
#   * clip_v2.onnx MNN'e cevrildikten sonra siliniyor
#   * asagidaki bayrak: kuantize DLC hazir olunca fp32 DLC siliniyor
# Bedeli: bir sonraki kosuda UNet donusumu + kuantizasyonu bastan yapilir.
# Diskin bol oldugu bir ortamda 0 yapin (yeniden kosular hizlanir).
OVERRIDE_FREE_FP_DLC=1

# --- Referans binary ile karsilastirma ---------------------------------------
# 2.39 ile de cihaz ayni hatayi verdi ("kod 1 / Could not free context").
# Bu, logun SON satiri — gercek hata gorunmuyor. Artik tahmin etmek yerine
# CALISAN bir referans paketi (HF: xororz/sd-qnn, *_min.zip) indirip
# metadata'yi bizimkiyle alan alan karsilastiriyoruz: dsp_arch, VTCM,
# optimizasyon seviyesi, graf adi, spill-fill boyutu, tensor sirasi/tipleri.
# ~900 MB indirir, unet.bin disindakini atar, karsilastirmadan sonra siler.
OVERRIDE_COMPARE_REF=0   # isini gordu; tekrar gerekirse 1 yapin
# Otomatik secim tutmazsa paketi elle verin:
#OVERRIDE_REF_ZIP=https://huggingface.co/xororz/sd-qnn/resolve/main/<paket>_min.zip
# Tekrar indirmemek icin referansi sakla (disk musaitse):
#OVERRIDE_KEEP_REF=1

# --- RESMI DONUSTURME SCRIPTLERI ---------------------------------------------
# Rehber: https://ld-guide.chino.icu/conversion/sd15
#   * "Qualcomm AI Engine Direct SDK 2.28 — please use v2.28 to avoid potential
#      issues" (yani surum tercih degil, sart)
#   * Script paketi: npuconvertv2.zip
#   * Akis: prepare_data.py -> gen_quant_data.py -> export_onnx.py ->
#           scripts/convert_all.sh --min_soc min
#   * Cikti: output/qnn_models_min/unet.bin ; paket <ad>_qnn2.28_min.zip
# Bizim tikandigimiz yer (girdi sirasi) bu scriptlerde zaten cozulmus olmali.
# 1 = indirir, acar ve convert_all.sh / export_onnx.py'yi loga doker.
OVERRIDE_FETCH_OFFICIAL=1
# Dogrudan link (rehberden alindi) — kesif adimina gerek yok:
OVERRIDE_OFFICIAL_SCRIPTS_URL=https://chino.icu/local-dream/npuconvertv2.zip
# Sadece scriptleri al, donusumu calistirma (hizli):
OVERRIDE_FETCH_ONLY=1

# --- Girdi sirasi kurali (TESHIS) --------------------------------------------
# Referansla karsilastirma UNet'in GIRDI SIRASININ ters oldugunu gosterdi:
#   referans: sample, timestamp, text_embedding
#   bizim   : text_embedding, timestamp, sample
# Motor tensorleri isimle degil INDEKSLE yaziyor, o yuzden bu paketi cihazda
# yuklenemez yapiyor ("kod 1 / Could not free context").
# Uc mekanizma olculup ELENDI: ONNX bildirim sirasi, --config YAML sirasi,
# --source_model_input_shape sirasi. Hicbiri binary sirasini degistirmiyor.
#
# PROBE_ORDER=1: gercek UNet yerine OYUNCAK modellerle (saniyeler) kurali olcer.
# Motor isimlere bakmadigi icin kural "isim uzunlugu" ise girdileri yeniden
# adlandirmak yeterli olur; degilse eski qnn-onnx-converter ->
# qnn-model-lib-generator -> qnn-context-binary-generator --model yoluna geceriz
# (referansin uretildigi yol; ikisi de bu SDK'da mevcut).
OVERRIDE_PROBE_ORDER=1
# Yoklamadan sonra dur — sira cozulmeden tam donusum zaten basarisiz bitiyor.
# 0 = yoklamadan sonra tam donusum de kossun. Artik kuralı biliyoruz ve
# dugum yeniden siralamasi devrede, dolayisiyla bu kosuda gercek deneme de olsun.
OVERRIDE_PROBE_ONLY=0

# --- Digerleri (gerekirse acilir) --------------------------------------------
#OVERRIDE_DSP_ARCH=v68
#OVERRIDE_TARGET_SOC=
#OVERRIDE_PER_CHANNEL=0
#OVERRIDE_QUANT_EXTRA=
#OVERRIDE_REBUILD_BIN=0
#OVERRIDE_UNET_WEIGHT_BW=8
